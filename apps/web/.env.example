# Echoray Commerce. Copy to apps/web/.dev.vars for local development (ignored by Git).
# Leave ECHORAY_STOREFRONT_ID empty to use the bundled catalog fixtures (no network, no credentials).
# Production: set the public values as Worker vars and the secret with
#   pnpm --filter @danirusev/web exec wrangler secret put ECHORAY_INTEGRATION_SECRET

# Public catalog gateway (default https://commerce.echoray.io).
ECHORAY_GATEWAY_URL=https://commerce.echoray.io
# Storefront integration ID (Admin -> Settings -> Website and domain). Public.
ECHORAY_STOREFRONT_ID=
# Voucher page (/vouchers/$token): server-only. The integration ID defaults to the storefront ID.
ECHORAY_CONVEX_URL=
ECHORAY_INTEGRATION_ID=
ECHORAY_INTEGRATION_SECRET=
