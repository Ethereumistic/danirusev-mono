{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "danirusev-web",
  "main": "@tanstack/react-start/server-entry",
  // Latest date supported by the pinned local workerd runtime at scaffold time.
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // Echoray Commerce (docs/storefront-echoray.md). dr11.echoray.cloud is routed here by
  // Echoray Connect, which also writes STOREFRONT_INTEGRATION_ID/SECRET/ORIGIN as secrets.
  // Without ECHORAY_STOREFRONT_ID the site serves bundled catalog fixtures.
  "vars": {
    "ECHORAY_GATEWAY_URL": "https://commerce.echoray.io",
    "ECHORAY_CONVEX_URL": "https://convex.echoray.io",
    // Public storefront integration ID (Echoray Connect); unset → bundled fixtures.
    "ECHORAY_STOREFRONT_ID": "p175c2xhv3vafj3hjq5hv225g98h3v4f"
  },
  // Keep the workers.dev URL and preview URLs for checks outside production.
  "workers_dev": true,
  "preview_urls": true,
  // Production domains (zone danirusev.com). www is attached so the Worker can 301 it
  // to the apex (src/start.ts). Cut over from the legacy Netlify site on 2026-10-28.
  "routes": [
    { "pattern": "danirusev.com", "custom_domain": true },
    { "pattern": "www.danirusev.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
